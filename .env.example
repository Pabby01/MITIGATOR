# MITIGATOR — Environment Variables Configuration
# Copy this file to .env.local to configure custom endpoints and API keys

# ─── Solana Network & RPC ───
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional Dedicated High-Performance RPC (e.g. Helius / QuickNode)
NEXT_PUBLIC_HELIUS_API_KEY=

# ─── Live Oracles & DeFi Routing ───
# Pyth Network Hermes Oracle Stream (Free Public API)
NEXT_PUBLIC_PYTH_HERMES_URL=https://hermes.pyth.network

# Jupiter DEX Aggregator API v6 (Free Public API)
NEXT_PUBLIC_JUPITER_QUOTE_API=https://quote-api.jup.ag/v6

# ─── Stocklana Hackathon: Tokens.xyz, Raydium & Meteora ───
# Tokens.xyz API v1 (Canonical Asset Resolution & Multi-Variant Comparison)
TOKENS_XYZ_API_URL=https://api.tokens.xyz/v1
TOKENS_XYZ_API_KEY=

# Raydium Trade API v1 & Data API v3
RAYDIUM_TRADE_API_URL=https://transaction-v1.raydium.io
RAYDIUM_DATA_API_URL=https://api-v3.raydium.io

# Meteora DLMM Data API (Dynamic Concentrated Liquidity Pools)
METEORA_API_URL=https://dlmm-api.meteora.ag

# ─── SEC EDGAR & TradFi Intelligence ───
# Mandatory User-Agent header for SEC EDGAR submissions API
SEC_EDGAR_USER_AGENT=MITIGATOR-App/1.0 (contact@mitigator.trade)

# Optional Financial News & Data Provider Keys
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Application Base URL
NEXT_PUBLIC_APP_URL=https://mitigator.trade

