# MITIGATOR — Environment Variables Configuration
# Copy this to .env.local for local development, or add these to your Vercel Project Settings

# ─── 1. Solana Network & RPC Configuration (Required) ───
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# For high throughput in production, you can replace with Helius / QuickNode / Alchemy Devnet RPC:
# NEXT_PUBLIC_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# ─── 2. Live Oracles & DeFi Routing (Required / Pre-configured) ───
NEXT_PUBLIC_PYTH_HERMES_URL=https://hermes.pyth.network
NEXT_PUBLIC_JUPITER_QUOTE_API=https://quote-api.jup.ag/v6
METEORA_API_URL=https://dlmm-api.meteora.ag
RAYDIUM_TRADE_API_URL=https://transaction-v1.raydium.io
RAYDIUM_DATA_API_URL=https://api-v3.raydium.io

# ─── 3. SEC EDGAR & Regulatory Pipeline (Required for 10-K Ingestion) ───
# Note: SEC requires a specific User-Agent format: Sample Company Name AdminContact@<sample company domain>.com
SEC_EDGAR_USER_AGENT=MITIGATOR-App/1.0 (contact@mitigator.trade)

# ─── 4. Application URL (Required for metadata & open-graph) ───
NEXT_PUBLIC_APP_URL=https://mitigator.trade

# ─── 5. Supabase Database & Realtime (Optional - For persistent storage) ───
# If omitted, MITIGATOR runs gracefully in local memory/cache mode
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── 6. AI Co-Pilot LLM Provider (Optional) ───
# If omitted, MITIGATOR uses its built-in rule-based quantitative reasoning engine
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── 7. Traditional Finance Market Data APIs (Optional) ───
TOKENS_XYZ_API_URL=https://api.tokens.xyz/v1
TOKENS_XYZ_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
